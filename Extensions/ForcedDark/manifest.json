{
  "manifest_version": 3,
  "name": "Forced Dark",
  "description": "Dark surfaces and readable text using Chromium’s CIELAB lightness inversion, while preserving images.",
  "version": "1.0.0",
  "permissions": ["storage"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "content_scripts": [{
    "matches": ["http://*/*", "https://*/*"],
    "js": ["colors.js", "content.js"],
    "css": ["loading.css"],
    "run_at": "document_start",
    "all_frames": true
  }],
  "action": {
    "default_title": "Forced Dark",
    "default_popup": "popup.html",
    "default_icon": "icon.svg"
  },
  "icons": {"48": "icon.svg", "128": "icon.svg"}
}
